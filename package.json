{
  "name": "lifter-file-viewer",
  "version": "1.0.0",
  "description": "Lifter-file-viewer",
  "homepage": "https://github.com/Lakshmipriyaindium/lifter-file-viewer#readme",
  "bugs": {
    "url": "https://github.com/Lakshmipriyaindium/lifter-file-viewer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lakshmipriyaindium/lifter-file-viewer.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "vite",
    "start": "concurrently -k \"npm run dev\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@types/plantuml-encoder": "^1.4.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.12",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "wait-on": "^9.0.5"
  },
  "dependencies": {
    "@radix-ui/react-toast": "^1.2.15",
    "@types/d3": "^7.4.3",
    "@types/dagre": "^0.7.54",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dagre": "^0.8.5",
    "framer-motion": "^12.38.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.14.0",
    "mermaid": "^11.14.0",
    "plantuml-encoder": "^1.4.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "reactflow": "^11.11.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.lifter.viewer",
    "productName": "Lifter-File-Viewer",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "package.json",
      "setup.command",
      "setup_win.bat"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}